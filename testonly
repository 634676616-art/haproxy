#!/usr/bin/env python3
"""
HAProxy Ingress Controller Migration Script
Migrates from community NGINX Ingress Controller to
HAProxy Technologies Ingress Controller.

Requirements:
    pip install pyyaml jinja2 kubernetes
    helm, kubectl, yq must be in PATH
"""

from __future__ import annotations

import json
import logging
import os
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import dataclass, field, asdict
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import yaml
from jinja2 import Environment, FileSystemLoader, StrictUndefined

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    datefmt="%Y-%m-%dT%H:%M:%S",
)
log = logging.getLogger("haproxy-migrate")


# ---------------------------------------------------------------------------
# Exceptions
# ---------------------------------------------------------------------------
class MigrationAbort(RuntimeError):
    """Fatal: abort entire migration."""


class TenantSkip(RuntimeError):
    """Non-fatal: skip a single tenant."""


# ---------------------------------------------------------------------------
# Data Models
# ---------------------------------------------------------------------------
@dataclass
class TenantInfo:
    tenant_full: str          # t-25690968-foo-ingress
    namespace: str            # same as tenant_full (or mapped)
    user_id: str              # 25690968
    tenant_short: str         # foo
    ingress_class: str        # haproxy-foo
    old_nodeport_https: int
    new_nodeport_https: int


@dataclass
class TenantResult:
    tenant_full: str
    status: str               # success | failed | skipped
    ingress_class: str = ""
    nodeport_https: int = 0
    reason: str = ""
    helm_release: str = ""


# ---------------------------------------------------------------------------
# Config Helpers
# ---------------------------------------------------------------------------
def load_config(path: str) -> dict:
    with open(path) as f:
        cfg = yaml.safe_load(f)
    return cfg


def must_get(cfg: dict, dotpath: str) -> Any:
    parts = dotpath.split(".")
    cur = cfg
    for p in parts:
        if not isinstance(cur, dict) or p not in cur:
            raise MigrationAbort(f"Missing required config key: {dotpath}")
        cur = cur[p]
    return cur


def deep_get(cfg: dict, dotpath: str, default=None) -> Any:
    try:
        return must_get(cfg, dotpath)
    except MigrationAbort:
        return default


# ---------------------------------------------------------------------------
# Shell Helpers
# ---------------------------------------------------------------------------
def run(cmd: list[str], capture: bool = True, check: bool = True,
        context: str = "") -> subprocess.CompletedProcess:
    if context:
        cmd = ["kubectl", "--context", context] + cmd[1:]
    log.debug("RUN: %s", " ".join(cmd))
    return subprocess.run(
        cmd,
        capture_output=capture,
        text=True,
        check=check,
    )


def kubectl(args: list[str], cfg: dict, **kwargs) -> subprocess.CompletedProcess:
    ctx = deep_get(cfg, "cluster.context", "")
    cmd = ["kubectl"] + args
    if ctx:
        cmd = ["kubectl", "--context", ctx] + args
    return run(cmd, **kwargs)


def helm(args: list[str], **kwargs) -> subprocess.CompletedProcess:
    return run(["helm"] + args, **kwargs)


# ---------------------------------------------------------------------------
# Pre-flight: infra node CPU check
# ---------------------------------------------------------------------------
def check_infra_cpu(cfg: dict) -> None:
    """
    Abort migration if any infra node CPU requests ratio exceeds threshold.
    Uses kubectl top nodes + kubectl describe nodes for capacity.
    """
    threshold = must_get(cfg, "cluster.infra_cpu_threshold")
    selector = must_get(cfg, "cluster.infra_node_selector")
    log.info("[PreCheck] Checking infra node CPU requests ratio (threshold=%.0f%%)...",
             threshold * 100)

    # Get node list matching selector
    res = kubectl(
        ["get", "nodes", "-l", selector, "-o",
         "jsonpath={.items[*].metadata.name}"],
        cfg,
    )
    nodes = res.stdout.strip().split()
    if not nodes:
        raise MigrationAbort(
            f"No infra nodes found with selector: {selector}"
        )

    violations = []
    for node in nodes:
        # Get allocatable CPU (in millicores)
        res_alloc = kubectl(
            ["get", "node", node, "-o",
             "jsonpath={.status.allocatable.cpu}"],
            cfg,
        )
        allocatable_raw = res_alloc.stdout.strip()
        allocatable_m = _parse_cpu_to_milli(allocatable_raw)

        # Get sum of CPU requests on this node
        res_pods = kubectl(
            ["get", "pods", "--all-namespaces",
             "--field-selector", f"spec.nodeName={node}",
             "-o", "jsonpath={.items[*].spec.containers[*].resources.requests.cpu}"],
            cfg,
        )
        total_req_m = sum(
            _parse_cpu_to_milli(x)
            for x in res_pods.stdout.strip().split()
            if x
        )

        ratio = total_req_m / allocatable_m if allocatable_m > 0 else 0.0
        log.info("  Node %-40s CPU requests ratio: %.1f%%", node, ratio * 100)
        if ratio > threshold:
            violations.append((node, ratio))

    if violations:
        lines = "\n".join(
            f"  - {n}: {r:.1%}" for n, r in violations
        )
        raise MigrationAbort(
            f"[ABORT] Infra node CPU requests ratio exceeds {threshold:.0%} "
            f"threshold:\n{lines}\nResolve capacity before migrating."
        )

    log.info("[PreCheck] Infra CPU check PASSED.")


def _parse_cpu_to_milli(raw: str) -> int:
    raw = raw.strip()
    if not raw:
        return 0
    if raw.endswith("m"):
        return int(raw[:-1])
    # plain cores (e.g. "2" or "0.5")
    try:
        return int(float(raw) * 1000)
    except ValueError:
        return 0


# ---------------------------------------------------------------------------
# Pre-flight: NodePort conflict detection
# ---------------------------------------------------------------------------
def check_nodeport_conflicts(
    cfg: dict, tenant_infos: list[TenantInfo]
) -> None:
    """
    Abort if any new NodePort is already in use by another Service.
    Reports the conflicting Service name/namespace/port.
    """
    log.info("[PreCheck] Scanning for NodePort conflicts...")

    # Build set of new nodeports we want to assign
    wanted: dict[int, str] = {}   # port -> tenant_full
    for t in tenant_infos:
        if t.new_nodeport_https in wanted:
            raise MigrationAbort(
                f"[ABORT] Two tenants want the same NodePort "
                f"{t.new_nodeport_https}: "
                f"{wanted[t.new_nodeport_https]} and {t.tenant_full}"
            )
        wanted[t.new_nodeport_https] = t.tenant_full

    # Get all existing NodePort services cluster-wide
    res = kubectl(
        ["get", "svc", "--all-namespaces", "-o", "json"],
        cfg,
    )
    svc_list = json.loads(res.stdout)

    conflicts = []
    for svc in svc_list.get("items", []):
        svc_ns = svc["metadata"]["namespace"]
        svc_name = svc["metadata"]["name"]
        for port in svc.get("spec", {}).get("ports", []):
            np = port.get("nodePort")
            if np and np in wanted:
                conflicts.append(
                    {
                        "nodeport": np,
                        "tenant": wanted[np],
                        "conflict_service": f"{svc_ns}/{svc_name}",
                        "port_name": port.get("name", ""),
                    }
                )

    if conflicts:
        lines = "\n".join(
            f"  - NodePort {c['nodeport']} wanted by [{c['tenant']}] "
            f"is already used by Service [{c['conflict_service']}] "
            f"port=[{c['port_name']}]"
            for c in conflicts
        )
        raise MigrationAbort(
            f"[ABORT] NodePort conflicts detected:\n{lines}\n"
            "Resolve all conflicts before proceeding."
        )

    log.info("[PreCheck] NodePort conflict check PASSED.")


# ---------------------------------------------------------------------------
# Tenant Discovery
# ---------------------------------------------------------------------------
def discover_tenants(cfg: dict) -> list[TenantInfo]:
    """
    Discover all Capsule Tenant CRs and build TenantInfo list.
    Naming convention: t-<userid>-<tenant_name>-ingress
    """
    log.info("[Discovery] Fetching Capsule Tenant CRs...")

    res = kubectl(
        ["get", "tenants.capsule.clastix.io",
         "-o", "json"],
        cfg,
    )
    tenant_crds = json.loads(res.stdout)

    skip = set(deep_get(cfg, "skip_tenants", []) or [])
    whitelist = set(deep_get(cfg, "tenant_whitelist", []) or [])
    prefix = must_get(cfg, "haproxy.ingress_class_prefix")
    offset = must_get(cfg, "nodeport.offset")
    port_min = must_get(cfg, "nodeport.range_min")
    port_max = must_get(cfg, "nodeport.range_max")
    overrides = deep_get(cfg, "tenant_overrides", {}) or {}

    infos: list[TenantInfo] = []

    for item in tenant_crds.get("items", []):
        name: str = item["metadata"]["name"]

        # Filter
        if name in skip or (name == "" and "" in skip):
            log.info("  Skipping (skip_tenants): %s", name)
            continue
        if whitelist and name not in whitelist:
            log.info("  Skipping (not in whitelist): %s", name)
            continue

        # Parse naming convention: t-<userid>-<tenant_name>-ingress
        if not _is_valid_tenant_name(name):
            log.warning("  Skipping (naming mismatch): %s", name)
            continue

        user_id, tenant_short = _parse_tenant_name(name)

        # Namespace = same as tenant_full (Capsule convention)
        namespace = name

        # Ingress class
        override = overrides.get(name, {})
        ingress_class = override.get(
            "ingress_class", f"{prefix}-{tenant_short}"
        )

        # NodePort: read from existing NGINX service, apply offset
        old_np = _get_nginx_nodeport(cfg, namespace)
        if old_np <= 0:
            log.warning(
                "  Skipping %s: cannot find existing NGINX NodePort", name
            )
            continue

        new_np = override.get("nodeport_https", old_np + offset)
        if not (port_min <= new_np <= port_max):
            log.warning(
                "  Skipping %s: computed NodePort %d is out of range [%d, %d]",
                name, new_np, port_min, port_max,
            )
            continue

        infos.append(TenantInfo(
            tenant_full=name,
            namespace=namespace,
            user_id=user_id,
            tenant_short=tenant_short,
            ingress_class=ingress_class,
            old_nodeport_https=old_np,
            new_nodeport_https=new_np,
        ))
        log.info(
            "  Discovered: %-50s ingress_class=%-30s nodeport: %d -> %d",
            name, ingress_class, old_np, new_np,
        )

    if not infos:
        raise MigrationAbort("No eligible tenants found. Check naming convention and config.")

    return infos


def _is_valid_tenant_name(name: str) -> bool:
    parts = name.split("-")
    # t-<userid>-<tenant>-ingress (minimum 4 parts)
    return (
        len(parts) >= 4
        and parts[0] == "t"
        and parts[-1] == "ingress"
    )


def _parse_tenant_name(name: str) -> tuple[str, str]:
    """
    name: t-<userid>-<tenant_short>-ingress
    Returns: (user_id, tenant_short)
    """
    parts = name.split("-")
    # parts[0] = "t"
    # parts[1] = userid
    # parts[2:-1] = tenant_short (may contain hyphens)
    # parts[-1] = "ingress"
    user_id = parts[1]
    tenant_short = "-".join(parts[2:-1])
    return user_id, tenant_short


def _get_nginx_nodeport(cfg: dict, namespace: str) -> int:
    """
    Find the existing NGINX Ingress Controller service in the given namespace
    and return its https NodePort.
    """
    try:
        res = kubectl(
            ["get", "svc", "-n", namespace,
             "-l", "app.kubernetes.io/name=ingress-nginx",
             "-o", "jsonpath={.items[0].spec.ports[?(@.name==\"https\")].nodePort}"],
            cfg,
        )
        val = res.stdout.strip()
        return int(val) if val else -1
    except (subprocess.CalledProcessError, ValueError):
        return -1


# ---------------------------------------------------------------------------
# Values Rendering
# ---------------------------------------------------------------------------
def render_values(cfg: dict, tenant: TenantInfo) -> Path:
    template_path = Path(must_get(cfg, "haproxy.values_template"))
    output_dir = Path(must_get(cfg, "execution.values_output_dir")) / tenant.tenant_full
    output_dir.mkdir(parents=True, exist_ok=True)
    output_file = output_dir / "values.yaml"

    env = Environment(
        loader=FileSystemLoader(str(template_path.parent)),
        undefined=StrictUndefined,
        trim_blocks=True,
        lstrip_blocks=True,
    )
    template = env.get_template(template_path.name)

    ctx = {
        "tenant_full": tenant.tenant_full,
        "namespace": tenant.namespace,
        "user_id": tenant.user_id,
        "tenant_short": tenant.tenant_short,
        "ingress_class": tenant.ingress_class,
        "nodeport_https": tenant.new_nodeport_https,
        "cr_global_cr_name": must_get(cfg, "haproxy.cr_global_cr_name"),
        "rendered_at": datetime.now(timezone.utc).isoformat(),
    }

    rendered = template.render(**ctx)
    output_file.write_text(rendered)
    log.debug("  Rendered values -> %s", output_file)
    return output_file


# ---------------------------------------------------------------------------
# Helm Deploy
# ---------------------------------------------------------------------------
def helm_add_repo(cfg: dict) -> None:
    repo_name = must_get(cfg, "haproxy.chart_repo")
    repo_url = must_get(cfg, "haproxy.chart_repo_url")
    log.info("[Helm] Adding repo %s -> %s", repo_name, repo_url)
    helm(["repo", "add", repo_name, repo_url, "--force-update"])
    helm(["repo", "update"])


def deploy_tenant(cfg: dict, tenant: TenantInfo, values_file: Path) -> str:
    """
    Helm upgrade --install for a single tenant.
    Returns helm release name.
    """
    chart = must_get(cfg, "haproxy.chart_name")
    version = must_get(cfg, "haproxy.chart_version")
    release = f"haproxy-{tenant.tenant_short}"
    namespace = tenant.namespace
    ctx = deep_get(cfg, "cluster.context", "")

    cmd = [
        "helm", "upgrade", "--install",
        release, chart,
        "--namespace", namespace,
        "--create-namespace",
        "--version", version,
        "--values", str(values_file),
        "--atomic",
        "--timeout", "5m",
        "--wait",
    ]
    if ctx:
        cmd += ["--kube-context", ctx]

    log.info(
        "  [Helm] upgrade --install release=%s namespace=%s", release, namespace
    )
    run(cmd, capture=False)
    return release


# ---------------------------------------------------------------------------
# ResourceQuota Patch (patch the tenant's quota to allow HAProxy resources)
# ---------------------------------------------------------------------------
def patch_resource_quota(cfg: dict, tenant: TenantInfo) -> None:
    """
    Optionally patch ResourceQuota in tenant namespace to account for
    HAProxy ingress controller additional pods.
    Currently: no-op placeholder -- extend as needed.
    """
    log.info(
        "  [Quota] ResourceQuota patch for %s (user_id=%s) -- no-op in this version",
        tenant.namespace, tenant.user_id,
    )


# ---------------------------------------------------------------------------
# Per-Tenant Migration
# ---------------------------------------------------------------------------
def migrate_tenant(cfg: dict, tenant: TenantInfo) -> TenantResult:
    dry_run = deep_get(cfg, "execution.dry_run", False)
    result = TenantResult(
        tenant_full=tenant.tenant_full,
        status="failed",
        ingress_class=tenant.ingress_class,
        nodeport_https=tenant.new_nodeport_https,
    )

    try:
        log.info("[Tenant] Processing: %s", tenant.tenant_full)

        # 1) Render values
        values_file = render_values(cfg, tenant)
        log.info("  Values rendered -> %s", values_file)

        if dry_run:
            log.info("  [DRY-RUN] Skipping helm deploy and quota patch.")
            result.status = "skipped"
            result.reason = "dry_run=true"
            result.helm_release = f"haproxy-{tenant.tenant_short} (dry-run)"
            return result

        # 2) Helm deploy
        release = deploy_tenant(cfg, tenant, values_file)
        result.helm_release = release

        # 3) ResourceQuota patch
        patch_resource_quota(cfg, tenant)

        result.status = "success"
        log.info("  [OK] %s migrated successfully.", tenant.tenant_full)

    except TenantSkip as e:
        result.status = "skipped"
        result.reason = str(e)
        log.warning("  [SKIP] %s: %s", tenant.tenant_full, e)

    except Exception as e:
        result.status = "failed"
        result.reason = str(e)
        log.error("  [FAIL] %s: %s", tenant.tenant_full, e, exc_info=True)

    return result


# ---------------------------------------------------------------------------
# Report Generation
# ---------------------------------------------------------------------------
def generate_reports(cfg: dict, results: list[TenantResult]) -> None:
    report_dir = Path(must_get(cfg, "execution.report_dir"))
    report_dir.mkdir(parents=True, exist_ok=True)

    now = datetime.now(timezone.utc).isoformat()
    total = len(results)
    success = sum(1 for r in results if r.status == "success")
    failed = sum(1 for r in results if r.status == "failed")
    skipped = sum(1 for r in results if r.status == "skipped")

    # ---- JSON report ----
    json_path = report_dir / "report.json"
    json_data = {
        "generated_at": now,
        "summary": {
            "total": total,
            "success": success,
            "failed": failed,
            "skipped": skipped,
        },
        "tenants": [asdict(r) for r in results],
    }
    json_path.write_text(json.dumps(json_data, indent=2, ensure_ascii=False))
    log.info("[Report] JSON -> %s", json_path)

    # ---- Markdown report ----
    md_path = report_dir / "report.md"
    lines = [
        "# HAProxy Ingress Migration Report",
        "",
        f"**Generated:** {now}",
        "",
        "## Summary",
        "",
        f"| Total | Success | Failed | Skipped |",
        f"|-------|---------|--------|---------|",
        f"| {total} | {success} | {failed} | {skipped} |",
        "",
        "## Tenant Results",
        "",
        "| Tenant | Status | IngressClass | NodePort (https) | Helm Release | Reason |",
        "|--------|--------|--------------|-----------------|--------------|--------|",
    ]

    for r in results:
        status_icon = {
            "success": "OK",
            "failed": "FAIL",
            "skipped": "SKIP",
        }.get(r.status, r.status)

        lines.append(
            f"| {r.tenant_full} "
            f"| **{status_icon}** "
            f"| `{r.ingress_class}` "
            f"| `{r.nodeport_https}` "
            f"| `{r.helm_release}` "
            f"| {r.reason} |"
        )

    lines += [
        "",
        "---",
        "_Generated by haproxy-migrate_",
    ]

    md_path.write_text("\n".join(lines))
    log.info("[Report] Markdown -> %s", md_path)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main() -> None:
    config_path = os.environ.get("MIGRATION_CONFIG", "config.yaml")
    if len(sys.argv) > 1:
        config_path = sys.argv[1]

    log.info("Loading config from: %s", config_path)
    cfg = load_config(config_path)

    dry_run = deep_get(cfg, "execution.dry_run", False)
    if dry_run:
        log.info("*** DRY-RUN MODE: No changes will be applied ***")

    # ---- Step 1: Pre-flight (global gates) ----
    try:
        check_infra_cpu(cfg)
    except MigrationAbort as e:
        log.critical(str(e))
        sys.exit(1)

    # ---- Step 2: Discover tenants ----
    try:
        tenant_infos = discover_tenants(cfg)
    except MigrationAbort as e:
        log.critical(str(e))
        sys.exit(1)

    log.info("[Discovery] Total eligible tenants: %d", len(tenant_infos))

    # ---- Step 3: NodePort conflict check (needs full list) ----
    try:
        check_nodeport_conflicts(cfg, tenant_infos)
    except MigrationAbort as e:
        log.critical(str(e))
        sys.exit(1)

    # ---- Step 4: Add helm repo (skip in dry-run) ----
    if not dry_run:
        try:
            helm_add_repo(cfg)
        except Exception as e:
            log.critical("[ABORT] Failed to add Helm repo: %s", e)
            sys.exit(1)

    # ---- Step 5: Migrate tenants ----
    results: list[TenantResult] = []
    parallelism = deep_get(cfg, "execution.parallel", 1)

    if parallelism > 1:
        with ThreadPoolExecutor(max_workers=parallelism) as executor:
            futures = {
                executor.submit(migrate_tenant, cfg, t): t
                for t in tenant_infos
            }
            for future in as_completed(futures):
                results.append(future.result())
    else:
        for t in tenant_infos:
            results.append(migrate_tenant(cfg, t))

    # Sort results by tenant_full for consistent report ordering
    results.sort(key=lambda r: r.tenant_full)

    # ---- Step 6: Generate reports ----
    generate_reports(cfg, results)

    # ---- Step 7: Exit code ----
    failed_count = sum(1 for r in results if r.status == "failed")
    if failed_count > 0:
        log.error("[DONE] Migration completed with %d failure(s). Check report.", failed_count)
        sys.exit(1)
    else:
        log.info("[DONE] Migration completed successfully. %d tenant(s) processed.", len(results))
        sys.exit(0)


if __name__ == "__main__":
    main()

