# ---------------------------------------------------------------------------
# Per-Tenant Migration  <-- MAIN FLOW WITH NEW LOGIC
# ---------------------------------------------------------------------------
def migrate_tenant(cfg: dict, tenant: TenantInfo) -> TenantResult:
    dry_run = deep_get(cfg, "execution.dry_run", False)
    result = TenantResult(
        tenant_full=tenant.tenant_full,
        status="failed",
        ingress_class=tenant.ingress_class,
        nodeport_https=tenant.new_nodeport_https,
    )

    try:
        log.info("[Tenant] Processing: %s", tenant.tenant_full)

        # ---- Gate: skip if HAProxy already deployed in this namespace ----
        has_hp, reason = namespace_has_haproxy_by_helm(cfg, tenant.namespace)
        if has_hp:
            raise TenantSkip(f"HAProxy already deployed: {reason}")

        # ---- Gate: skip if namespace has >1 NodePort (manual handling) ----
        np_port_count, np_details = count_nodeport_ports_in_namespace(
            cfg, tenant.namespace
        )
        if np_port_count > 1:
            detail_str = "; ".join(
                f"{d['service']}:{d.get('port_name', '')} nodePort={d['nodePort']}"
                for d in np_details
            )
            raise TenantSkip(
                f"namespace {tenant.namespace} has {np_port_count} NodePort ports (>1); "
                f"skip for manual handling. Details: {detail_str}"
            )

        # ---- Step 1: Render base values (Jinja2) ----
        values_file = render_values(cfg, tenant)
        log.info("  Values rendered -> %s", values_file)

        # ---- Step 2: NEW -- Discover tenant namespaces -> build whitelist ----
        tenant_namespaces = get_tenant_namespaces(cfg, tenant.tenant_full)
        whitelist_override_yaml = build_whitelist_override_yaml(
            cfg, tenant_namespaces
        )

        if dry_run:
            log.info(
                "  [DRY-RUN] Would inject namespace whitelist:\n%s",
                whitelist_override_yaml.strip(),
            )
            log.info("  [DRY-RUN] Skipping helm deploy and quota patch.")
            result.status = "skipped"
            result.reason = "dry_run=true"
            result.helm_release = f"haproxy-{tenant.tenant_short} (dry-run)"
            return result

        # ---- Step 3: Bump Capsule Tenant quota: services.nodeports (+1) ----
        old_npq = new_npq = None
        try:
            old_npq, new_npq = bump_tenant_services_nodeports(
                cfg,
                tenant_name=tenant.tenant_full,
                delta=1,
                dry_run=False,
            )
            log.info(
                "  [CapsuleQuota] %s services.nodeports: %s -> %s",
                tenant.tenant_full, old_npq, new_npq,
            )

            # ---- Step 4: Helm deploy (with whitelist injected) ----
            release = deploy_tenant(
                cfg, tenant, values_file, whitelist_override_yaml
            )
            result.helm_release = release

        except Exception:
            # Best-effort rollback: revert quota bump on failure
            if old_npq is not None:
                try:
                    patch_ops = [
                        {
                            "op": "replace",
                            "path": "/spec/resourceQuotas/items/0/hard/services.nodeports",
                            "value": str(old_npq),
                        }
                    ]
                    kubectl(
                        [
                            "patch", "tenant", tenant.tenant_full,
                            "--type=json",
                            "-p", json.dumps(patch_ops),
                        ],
                        cfg,
                    )
                    log.warning(
                        "  [CapsuleQuota] Rolled back %s services.nodeports to %s",
                        tenant.tenant_full, old_npq,
                    )
                except Exception as re:
                    log.error(
                        "  [CapsuleQuota] Rollback FAILED for %s: %s",
                        tenant.tenant_full, re,
                        exc_info=True,
                    )
            raise

        # ---- Step 5: ResourceQuota patch (placeholder) ----
        patch_resource_quota(cfg, tenant)

        result.status = "success"
        log.info("  [OK] %s migrated successfully.", tenant.tenant_full)

    except TenantSkip as e:
        result.status = "skipped"
        result.reason = str(e)
        log.warning("  [SKIP] %s: %s", tenant.tenant_full, e)

    except Exception as e:
        result.status = "failed"
        result.reason = str(e)
        log.error("  [FAIL] %s: %s", tenant.tenant_full, e, exc_info=True)

    return result


# ---------------------------------------------------------------------------
# Report Generation
# ---------------------------------------------------------------------------
def generate_reports(cfg: dict, results: list[TenantResult]) -> None:
    report_dir = Path(must_get(cfg, "execution.report_dir"))
    report_dir.mkdir(parents=True, exist_ok=True)

    now = datetime.now(timezone.utc).isoformat()
    total = len(results)
    success = sum(1 for r in results if r.status == "success")
    failed = sum(1 for r in results if r.status == "failed")
    skipped = sum(1 for r in results if r.status == "skipped")

    # ---- JSON report ----
    json_path = report_dir / "report.json"
    json_data = {
        "generated_at": now,
        "summary": {
            "total": total,
            "success": success,
            "failed": failed,
            "skipped": skipped,
        },
        "tenants": [asdict(r) for r in results],
    }
    json_path.write_text(
        json.dumps(json_data, indent=2, ensure_ascii=False)
    )
    log.info("[Report] JSON -> %s", json_path)

    # ---- Markdown report ----
    md_path = report_dir / "report.md"
    lines = [
        "# HAProxy Ingress Migration Report",
        "",
        f"**Generated:** {now}",
        "",
        "## Summary",
        "",
        "| Total | Success | Failed | Skipped |",
        "|-------|---------|--------|---------|",
        f"| {total} | {success} | {failed} | {skipped} |",
        "",
        "## Tenant Results",
        "",
        "| Tenant | Status | IngressClass | NodePort (https) | Helm Release | Reason |",
        "|--------|--------|--------------|-----------------|--------------|--------|",
    ]

    for r in results:
        status_icon = {
            "success": "OK",
            "failed": "FAIL",
            "skipped": "SKIP",
        }.get(r.status, r.status)

        lines.append(
            f"| {r.tenant_full} "
            f"| **{status_icon}** "
            f"| `{r.ingress_class}` "
            f"| `{r.nodeport_https}` "
            f"| `{r.helm_release}` "
            f"| {r.reason} |"
        )

    lines += [
        "",
        "---",
        "_Generated by haproxy-migrate_",
    ]

    md_path.write_text("\n".join(lines))
    log.info("[Report] Markdown -> %s", md_path)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main() -> None:
    config_path = os.environ.get("MIGRATION_CONFIG", "config.yaml")
    if len(sys.argv) > 1:
        config_path = sys.argv[1]

    log.info("Loading config from: %s", config_path)
    cfg = load_config(config_path)

    dry_run = deep_get(cfg, "execution.dry_run", False)
    if dry_run:
        log.info("*** DRY-RUN MODE: No changes will be applied ***")

    # ---- Step 1: Pre-flight (global gates) ----
    try:
        check_infra_cpu(cfg)
    except MigrationAbort as e:
        log.critical(str(e))
        sys.exit(1)

    # ---- Step 2: Discover tenants (from Capsule Tenant CRs) ----
    try:
        tenant_infos = discover_tenants(cfg)
    except MigrationAbort as e:
        log.critical(str(e))
        sys.exit(1)

    log.info("[Discovery] Total eligible tenants: %d", len(tenant_infos))

    # ---- Step 3: NodePort conflict check ----
    try:
        check_nodeport_conflicts(cfg, tenant_infos)
    except MigrationAbort as e:
        log.critical(str(e))
        sys.exit(1)

    # ---- Step 4: Add helm repo (skip in dry-run) ----
    if not dry_run:
        try:
            helm_add_repo(cfg)
        except Exception as e:
            log.critical("[ABORT] Failed to add Helm repo: %s", e)
            sys.exit(1)

    # ---- Step 5: Migrate tenants ----
    results: list[TenantResult] = []
    parallelism = deep_get(cfg, "execution.parallel", 1)

    if parallelism > 1:
        with ThreadPoolExecutor(max_workers=parallelism) as executor:
            futures = {
                executor.submit(migrate_tenant, cfg, t): t
                for t in tenant_infos
            }
            for future in as_completed(futures):
                results.append(future.result())
    else:
        for t in tenant_infos:
            results.append(migrate_tenant(cfg, t))

    # Sort for consistent report ordering
    results.sort(key=lambda r: r.tenant_full)

    # ---- Step 6: Generate reports ----
    generate_reports(cfg, results)

    # ---- Step 7: Exit code ----
    failed_count = sum(1 for r in results if r.status == "failed")
    if failed_count > 0:
        log.error(
            "[DONE] Migration completed with %d failure(s). Check report.",
            failed_count,
        )
        sys.exit(1)
    else:
        log.info(
            "[DONE] Migration completed successfully. %d tenant(s) processed.",
            len(results),
        )
        sys.exit(0)


if __name__ == "__main__":
    main()
