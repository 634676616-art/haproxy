                            new_annos[rule['target']] = value
                            
                        elif rule['type'] == 'configmap':
                            # ConfigMap 可能没有 target，使用安全的 .get() 方法，如果没有 target 就用原 key 代替显示
                            display_name = rule.get('target', key)
                            notices.append(f"[ConfigMap] {display_name}: {rule.get('note', '')}")
                            
